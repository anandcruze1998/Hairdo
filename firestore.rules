rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /salons/{salonId} {
      allow read, write: if true; // Relaxed for Developer View Switcher prototyping
    }
    match /bookings/{bookingId} {
      allow read, write: if true; // Keeping open for prototype
    }
    match /users/{userId} {
      allow read, write: if true; // Relaxed for Developer View Switcher prototyping
    }
  }
}
